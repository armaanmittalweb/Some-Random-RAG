# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash-lite
GEMINI_SIMILARITY_MODEL=gemini-2.0-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# MongoDB Atlas
MONGODB_URI=
MONGODB_DATABASE=transcript_rag
# Used by the local Express server; the Cloudflare Worker uses MONGODB_DATABASE.
MONGODB_DB=transcript_rag
MONGODB_COLLECTION=transcript_chunks
MONGODB_VECTOR_INDEX=transcript_vector_index
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_CHAT_FALLBACK_MODEL=gemini-2.5-flash-lite
# Ordered highest-quality to fastest fallback. Comma-separated model names.
GEMINI_CHAT_MODEL_CHAIN=gemma-4-31b-it,gemini-3.5-flash,gemini-2.5-flash,gemini-2.5-flash-lite
PORT=3001

# Cloudflare Worker frontend proxy
API_ORIGIN=https://replace-with-your-api-host.example.com
