{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fieldnotes-rag",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-22",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "API_ORIGIN": "https://replace-with-your-api-host.example.com"
  }
}
